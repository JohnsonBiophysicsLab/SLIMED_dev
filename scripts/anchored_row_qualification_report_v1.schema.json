      "required": ["expected_artifacts", "observed_artifacts", "expected_bfr_cases", "observed_bfr_cases", "expected_far_cases", "observed_far_cases", "expected_cache_pairs", "observed_cache_pairs", "expected_raw_bfr_rows", "observed_raw_bfr_rows", "expected_anchor_rows", "observed_anchor_rows", "expected_provider_terms", "observed_provider_terms", "expected_anchor_terms", "observed_anchor_terms", "ledgers", "unexpected_paths"],
      "properties": {"expected_artifacts": {"const": 294}, "observed_artifacts": {"type": "integer"}, "expected_bfr_cases": {"const": 196}, "observed_bfr_cases": {"type": "integer"}, "expected_far_cases": {"const": 98}, "observed_far_cases": {"type": "integer"}, "expected_cache_pairs": {"const": 98}, "observed_cache_pairs": {"type": "integer"}, "expected_raw_bfr_rows": {"const": 1386000}, "observed_raw_bfr_rows": {"type": "integer"}, "expected_anchor_rows": {"const": 4158000}, "observed_anchor_rows": {"type": "integer"}, "expected_provider_terms": {"const": 12549936}, "observed_provider_terms": {"type": "integer"}, "expected_anchor_terms": {"const": 37649808}, "observed_anchor_terms": {"type": "integer"}, "ledgers": {"type": "array", "items": {"$ref": "#/$defs/ledger"}}, "unexpected_paths": {"type": "array", "items": {"$ref": "#/$defs/hashBinding"}}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "target", "expectation", "applicability", "expected_cell_count", "observed_cell_count", "key_ledger_sha256", "status", "maximum", "witness", "first_failing_key", "omission_blocker"],
      "properties": {"criterion_id": {"type": "string"}, "target": {"type": ["number", "null"]}, "expectation": {"type": ["string", "null"]}, "applicability": {"type": "string"}, "expected_cell_count": {"type": "integer", "minimum": 0}, "observed_cell_count": {"type": "integer", "minimum": 0}, "key_ledger_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["PASS", "FAIL", "INCOMPLETE", "UNCOVERED", "OMITTED_AFTER_CANDIDATE_FAILURE", "OMITTED_AFTER_INFRASTRUCTURE_FAILURE"]}, "maximum": {"type": ["number", "null"]}, "witness": {"type": ["array", "null"]}, "first_failing_key": {"type": ["array", "null"]}, "omission_blocker": {"type": ["string", "null"]}}
