      "required": ["availability", "git_head", "row_provider_binary_sha256", "release_complete"],
      "properties": {"availability": {"$ref": "#/$defs/availability"}, "git_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "row_provider_binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "release_complete": {"type": ["boolean", "null"]}}
