      "properties": {
        "manifest_file_sha256": {"const": "bdadac60281c0430789e079cefb819c0c8e127899d4ede4ba7227d233452a07b"},
        "manifest_contract_sha256": {"const": "30db9a564c165c2f04125f25a983df6301225ca4355386bf5c91a500ea67f368"},
        "rows": {"const": ["position", "du", "dv", "duu", "duv", "dvv"]},
        "row_invariant_tolerance": {"const": 1e-12}, "d10": {"$ref": "#/$defs/target"}, "component_targets": {"$ref": "#/$defs/target"},
        "inner_radius_rule": {"const": "r < 2^-8 excluded"}, "anchor_order": {"const": ["v0", "v1", "v2"]},
        "relabels": {"const": ["identity", "rank_reverse", "rank_rotate_1"]},
        "canonical_sample_order": {"type": "array", "minItems": 34, "items": {"type": "string"}},
        "radius_exponents": {"const": [1, 2, 3, 4, 5, 6, 7, 8]},
        "ray_sequence": {"const": [0, 1, 2]},
        "source_order": {"const": "strictly_increasing_signed_source_id"},
        "expected_fixture_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashBinding"}},
        "actual_fixture_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashBinding"}},
        "d12_contract": {"type": "object", "additionalProperties": false, "required": ["preparation_median_ms", "preparation_single_run_failstop_ms", "retained_row_payload_bytes_per_face", "preparation_peak_rss_delta_mib"], "properties": {"preparation_median_ms": {"const": 1000}, "preparation_single_run_failstop_ms": {"const": 10000}, "retained_row_payload_bytes_per_face": {"const": 131072}, "preparation_peak_rss_delta_mib": {"const": 64}}},
        "physical_fingerprint": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    },
    "checkpoint": {
