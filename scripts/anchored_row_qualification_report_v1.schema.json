    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["content_id", "candidate", "cache_mode", "level", "availability", "compressed_sha256", "json_sha256", "b2rowv1_sha256"],
      "properties": {"content_id": {"type": "string"}, "candidate": {"enum": ["bfr", "far"]}, "cache_mode": {"type": "string"}, "level": {"type": "integer", "minimum": 2, "maximum": 8}, "availability": {"$ref": "#/$defs/availability"}, "compressed_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "json_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "b2rowv1_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
