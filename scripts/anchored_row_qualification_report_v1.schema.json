      "properties": {"status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}, "first_decisive_criterion": {"type": ["string", "null"]}, "failed": {"type": "array", "items": {"type": "string"}}, "incomplete": {"type": "array", "items": {"type": "string"}}, "uncovered": {"type": "array", "items": {"type": "string"}}, "omitted": {"type": "array", "items": {"type": "string"}}, "serial_only_qualification_eligible": {"type": "boolean"}, "serial_only_reason": {"enum": ["ELIGIBLE_PENDING_EXPLICIT_USER_DECISION", "NOT_ELIGIBLE"]}, "threaded_only_failure_ledger_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "report_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "qualification_decided": {"const": false}, "d9a_reopened": {"const": false}, "b3_unblocked": {"const": false}, "far_selected": {"const": false}, "production_authorized": {"const": false}}
