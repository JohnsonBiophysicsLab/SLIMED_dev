      "required": ["criterion_id", "partition", "expected_count", "observed_count", "key_ledger_sha256", "availability", "omission_blocker"],
      "properties": {"criterion_id": {"type": "string"}, "partition": {"type": "string"}, "expected_count": {"type": ["integer", "null"], "minimum": 0}, "observed_count": {"type": "integer", "minimum": 0}, "key_ledger_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "availability": {"$ref": "#/$defs/availability"}, "omission_blocker": {"type": ["string", "null"]}}
    },
    "scientificKey": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "prefixItems": [
        {"type": "string"}, {"enum": ["cache_disabled", "serial_cache", "cache_pair", null]},
        {"type": "integer", "minimum": 2, "maximum": 8}, {"type": "integer", "minimum": 0},
        {"type": ["integer", "null"], "minimum": 0}, {"type": "string"},
        {"enum": ["position", "du", "dv", "duu", "duv", "dvv", "area_integrand", "legacy_volume_integrand"]},
        {"enum": ["exact_effective", "emitted_binary64", "structural", null]},
        {"enum": ["v0", "v1", "v2", null]}, {"enum": ["identity", "rank_reverse", "rank_rotate_1", null]},
        {"type": ["integer", "null"]}, {"enum": ["x", "y", "z", null]},
        {"enum": ["v0_v1", "v0_v2", "v1_v2", null]}, {"enum": ["6_7", "7_8", null]},
        {"enum": ["positive_zero", "positive_one", "negative_one", "positive_2p20", "negative_2p20", null]}
      ], "items": false
    },
    "d12Key": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "prefixItems": [
        {"type": "string"}, {"type": "integer", "minimum": 2, "maximum": 8}, {"enum": ["release", "tsan"]},
        {"enum": ["cache_disabled", "serial_cache", "threaded_cache"]}, {"enum": [1, 2, 4, null]},
        {"type": ["integer", "null"], "minimum": 0, "maximum": 3}, {"type": ["integer", "null"], "minimum": 0, "maximum": 19},
        {"enum": ["warmup", "measured", null]}, {"type": ["integer", "null"], "minimum": 0, "maximum": 14},
        {"type": ["integer", "null"], "minimum": 0}, {"type": ["integer", "null"], "minimum": 0}, {"type": ["string", "null"]},
        {"enum": ["pre_refiner_baseline", "after_refiner", "after_factory_cache", "after_face_insert", "after_package_publication", "after_package_destruction", "after_factory_cache_destruction", "after_refiner_destruction", "thread_result", "sanitizer_summary", null]},
        {"enum": ["preparation_duration_ns", "preparation_median_ns", "retained_payload_bytes", "rss_bytes", "row_digest", "instrumentation_coverage", "tsan_finding_count"]}
      ], "items": false
    },
    "matrix": {
